# Điền rồi lưu file. File này KHÔNG được đưa lên GitHub.

# Key OpenAI (não dự phòng, hoặc não chính nếu chưa có key FLOP): platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY=

# (Tuỳ chọn) Não FLOP: đường dẫn file key gateway do Flop CLI tạo (`flop agent credential`).
# Có file này → agent trả compute bằng $FLOP (được tính airdrop agent), OpenAI chỉ còn là dự phòng.
# Bỏ trống = chỉ dùng OpenAI. Trong image CLI chính thức (chạy trên VPS) không cần điền.
FLOP_KEY_FILE=

# Token bot Telegram: nhắn @BotFather → /newbot → làm theo → copy token
TELEGRAM_BOT_TOKEN=

# Tên DID bạn đã tạo bằng: node scripts/generate-did.js <ten>
DID_LABEL=
